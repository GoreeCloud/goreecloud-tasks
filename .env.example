# GoreeCloud Tasks development environment template.
# Copy this file to .env for Docker development. Do not commit the active .env.

# General
TZ=America/Chicago
DJANGO_TIME_ZONE=America/Chicago
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
APP_PORT=8000

# User reminders and ntfy development integration.
# Leave NTFY_BASE_URL blank to keep network delivery disabled.
# For an isolated development test, NTFY_ACCESS_TOKEN may be set only in the
# uncommitted .env. Long-lived or production use must prefer NTFY_ACCESS_TOKEN_FILE
# backed by an approved protected secret mount; no token belongs in Git.
NTFY_BASE_URL=
NTFY_ACCESS_TOKEN=
NTFY_ACCESS_TOKEN_FILE=
NTFY_TOPIC_PREFIX=goreecloud-tasks
NTFY_TIMEOUT_SECONDS=10
# Optional click target for delivered reminders. Keep blank until the application
# address for the current environment is actually deployed and approved.
TASKS_BASE_URL=

# File-based secret source paths used by Docker Compose.
# Create these files locally with unique values; never commit their contents.
# The secret files use this numeric group so the non-root web container can
# receive group-read access without making the files world-readable.
APP_SECRET_GID=20001
DJANGO_SECRET_KEY_SOURCE=./secrets/django_secret_key
POSTGRES_PASSWORD_SOURCE=./secrets/postgres_password

# PostgreSQL development database
POSTGRES_DB=goreecloud_tasks
POSTGRES_USER=goreecloud_tasks
