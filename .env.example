# GoreeCloud Tasks development environment template.
# Copy this file to .env for Docker development. Do not commit the active .env.

# General
TZ=America/Chicago
DJANGO_TIME_ZONE=America/Chicago
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
APP_PORT=8000

# User reminders and ntfy development integration.
# Leave NTFY_BASE_URL blank to keep network delivery disabled.
# For an isolated development test, NTFY_ACCESS_TOKEN may be set only in the
# uncommitted .env. Long-lived or production use must prefer NTFY_ACCESS_TOKEN_FILE
# backed by an approved protected secret mount; no token belongs in Git.
NTFY_BASE_URL=
NTFY_ACCESS_TOKEN=
NTFY_ACCESS_TOKEN_FILE=
NTFY_TOPIC_PREFIX=goreecloud-tasks
NTFY_TIMEOUT_SECONDS=10
# Optional click target for delivered reminders. Keep blank until the application
# address for the current environment is actually deployed and approved.
TASKS_BASE_URL=

# GoreeCloud Manager read-only API integration.
# Disabled by default. When enabled, TASKS_MANAGER_API_USERNAME must identify an
# existing active Tasks account whose project memberships define Manager's exact
# read scope. The bearer token maps only to that configured identity; Manager cannot
# select another user through the API. Use a long random development token only in
# the uncommitted .env. Long-lived deployments must prefer the protected file source.
TASKS_MANAGER_API_ENABLED=false
TASKS_MANAGER_API_USERNAME=
TASKS_MANAGER_API_TOKEN=
TASKS_MANAGER_API_TOKEN_FILE=
TASKS_MANAGER_API_MAX_TASKS=100

# GoreeCloud Calendar read-only task projection integration.
# This first source-level contract maps one bearer token to exactly one existing
# active Tasks account and exposes only that account's currently visible scheduled
# active tasks. The request cannot choose another Tasks identity. This is a
# development foundation, not the final multi-user credential/Identity design.
# Long-lived deployments must prefer the protected file source over direct tokens.
TASKS_CALENDAR_API_ENABLED=false
TASKS_CALENDAR_API_USERNAME=
TASKS_CALENDAR_API_TOKEN=
TASKS_CALENDAR_API_TOKEN_FILE=
TASKS_CALENDAR_API_MAX_TASKS=500

# Optional outgoing GoreeCloud Calendar busy-time context for the Agenda.
# Disabled by default. The username binds one configured Calendar context to one
# local authenticated Tasks account; it is never sent as a Calendar subject selector.
# Calendar independently controls its authorized subject and collection set.
# Non-loopback endpoints must use HTTPS. Development may use the direct token only in
# the uncommitted .env; long-lived deployments should use a protected file source and
# still require the applicable Identity, privacy, security, continuity, and deployment
# acceptance gates before production use.
TASKS_CALENDAR_BUSY_ENABLED=false
TASKS_CALENDAR_BUSY_USERNAME=
TASKS_CALENDAR_BUSY_BASE_URL=
TASKS_CALENDAR_BUSY_TOKEN=
TASKS_CALENDAR_BUSY_TOKEN_FILE=
TASKS_CALENDAR_BUSY_TIMEOUT_SECONDS=5

# File-based secret source paths used by Docker Compose.
# Create these files locally with unique values; never commit their contents.
# The secret files use this numeric group so the non-root web container can
# receive group-read access without making the files world-readable.
APP_SECRET_GID=20001
DJANGO_SECRET_KEY_SOURCE=./secrets/django_secret_key
POSTGRES_PASSWORD_SOURCE=./secrets/postgres_password

# PostgreSQL development database
POSTGRES_DB=goreecloud_tasks
POSTGRES_USER=goreecloud_tasks
